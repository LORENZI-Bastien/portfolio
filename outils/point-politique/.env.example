# Copier en .env puis remplir (ne jamais partager ce fichier).
# Webhook Discord d'un salon dédié (ex. #politique) : Paramètres du salon > Intégrations > Webhooks.
DISCORD_WEBHOOK_URL=
# Heure d'envoi (heure de Paris)
HEURE_ENVOI=07:30
# Jours de rattrapage au tout premier envoi
JOURS_PREMIER_ENVOI=3
# Facultatif : paragraphe « contexte » écrit par l'IA locale (Ollama). Vide = désactivé.
# Si la tour est éteinte, le point part quand même, sans ce paragraphe.
OLLAMA_URL=
OLLAMA_MODELE=qwen3.5:4b
